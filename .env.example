# Frontend env — these ship to the browser and are SAFE to expose.
# The anon key is protected by Supabase Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: your Claude/Anthropic key is NOT here. It lives only in the
# Supabase Edge Function secrets (server-side). See README.
